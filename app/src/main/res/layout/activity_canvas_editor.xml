<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep"
    android:orientation="vertical"
    tools:context=".ui.CanvasEditorActivity">

    <!-- ============ TOP BAR ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="10dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp">

        <ImageButton
            android:id="@+id/btnCanvasBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/arrow_back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/canvasProjectName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="My Music Live" />

            <TextView
                android:id="@+id/canvasFormatLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/secondary_cyan"
                android:textSize="11sp"
                tools:text="16:9 Landscape • 1920×1080 • 30 FPS" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCanvasSave"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/save"
            app:icon="@drawable/ic_check" />
    </LinearLayout>

    <!-- ============ OUTPUT FORMAT ============ -->
    <!-- Row 1: aspect presets only (scrollable, no dropdown crowding). -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAspect169"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="16:9"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnAspect916"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="9:16"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnAspect11"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="1:1"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnAspect45"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="4:5"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnAspectCustom"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/custom"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Row 2: resolution dropdown on its own line — never overlaps the aspect
        chips on small screens. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="2dp"
        android:paddingEnd="16dp">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:hint="@string/resolution_label">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/canvasResolution"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:maxLines="1"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/canvasFormatNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="2dp"
        android:paddingEnd="16dp"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        tools:text="Encoder ready ✓ • ~2s keyframes • CBR" />

    <!-- ============ CANVAS PREVIEW ============ -->
    <FrameLayout
        android:id="@+id/previewContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:background="@color/preview_bg">

        <SurfaceView
            android:id="@+id/canvasPreviewSurface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <com.livevip.app.ui.CanvasAidsView
            android:id="@+id/canvasAids"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- ============ TRANSFORM ROW ============ -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnFit"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:text="@string/fit"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnFill"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:text="@string/fill"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnCenter"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:text="@string/center"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnZoomIn"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:text="＋"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnZoomOut"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:text="－"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnRotateLeft"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:text="↺"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnRotateRight"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:text="↻"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnResetTransform"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:text="@string/reset"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnStretch"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:text="@string/stretch"
                android:textColor="@color/warning_amber"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- ============ PREVIEW AIDS ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipGrid"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/grid"
            android:textSize="11sp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSafeArea"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/safe_area"
            android:textSize="11sp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSnap"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/snap"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- ============ BOTTOM TABS ============ -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/canvasTabToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <Button
            android:id="@+id/tabLayers"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/layers"
            android:textSize="12sp" />

        <Button
            android:id="@+id/tabScenes"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/scenes"
            android:textSize="12sp" />

        <Button
            android:id="@+id/tabTemplates"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/templates"
            android:textSize="12sp" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- ============ PANEL ============ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="240dp">

        <!-- LAYERS -->
        <LinearLayout
            android:id="@+id/layersPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnAddImage"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:minWidth="0dp"
                        android:text="@string/add_image"
                        android:textSize="11sp"
                        app:icon="@drawable/ic_image"
                        app:iconSize="14dp" />

                    <Button
                        android:id="@+id/btnAddVideo"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:minWidth="0dp"
                        android:text="@string/add_video"
                        android:textSize="11sp"
                        app:icon="@drawable/ic_folder_video"
                        app:iconSize="14dp" />

                    <Button
                        android:id="@+id/btnAddGif"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:minWidth="0dp"
                        android:text="@string/add_gif"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnAddText"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:minWidth="0dp"
                        android:text="@string/add_text"
                        android:textSize="11sp"
                        app:icon="@drawable/ic_text_overlay"
                        app:iconSize="14dp" />

                    <Button
                        android:id="@+id/btnAddSubscribe"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:minWidth="0dp"
                        android:text="@string/add_subscribe"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnAddClock"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:minWidth="0dp"
                        android:text="@string/add_clock"
                        android:textSize="11sp"
                        app:icon="@drawable/ic_clock"
                        app:iconSize="14dp" />

                    <Button
                        android:id="@+id/btnAddCountdown"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:minWidth="0dp"
                        android:text="@string/add_countdown"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnAddScroll"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:minWidth="0dp"
                        android:text="@string/add_scrolling"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnAddLowerThird"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:minWidth="0dp"
                        android:text="@string/add_lower_third"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnAddBorder"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:minWidth="0dp"
                        android:text="@string/add_border"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnAddBackground"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:minWidth="0dp"
                        android:text="@string/add_background"
                        android:textSize="11sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/layersList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="6dp" />
        </LinearLayout>

        <!-- SCENES -->
        <LinearLayout
            android:id="@+id/scenesPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp">

                <Button
                    android:id="@+id/btnAddScene"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="@string/save_scene"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_add" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/scenesList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="6dp" />
        </LinearLayout>

        <!-- TEMPLATES -->
        <LinearLayout
            android:id="@+id/templatesPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp">

                <Button
                    android:id="@+id/btnSaveTemplate"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="@string/save_as_template"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_add" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/templatesList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="6dp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
