<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/arrow_back"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/editorTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:letterSpacing="0.06"
                android:text="@string/project_editor_new"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Project name -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/nameLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="@string/project_name_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Source mode -->
        <TextView
            style="@style/SettingsSectionHeader"
            android:text="@string/source_label" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/sourceToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <Button
                android:id="@+id/btnSourceVideo"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/source_video_live" />

            <Button
                android:id="@+id/btnSourceCamera"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/source_camera" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Playlist -->
        <LinearLayout
            android:id="@+id/playlistSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/SettingsSectionHeader"
                android:text="@string/section_playlist" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/playlistList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                tools:itemCount="3" />

            <Button
                android:id="@+id/btnAddVideo"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/add_video_to_playlist"
                app:icon="@drawable/ic_add" />

            <TextView
                android:id="@+id/playlistEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/playlist_empty"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:visibility="gone" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/loop_mode_label">

                <AutoCompleteTextView
                    android:id="@+id/loopModeDropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/loopModeDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/loop_all_desc"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Broadcast mode -->
        <TextView
            style="@style/SettingsSectionHeader"
            android:text="@string/section_broadcast_mode" />

        <RadioGroup
            android:id="@+id/broadcastModeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/radioDirect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:text="@string/direct_rtmp"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/radioRelay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:text="@string/smart_relay"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </RadioGroup>

        <!-- Destinations -->
        <TextView
            style="@style/SettingsSectionHeader"
            android:text="@string/section_destinations" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/destinationsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            tools:itemCount="2" />

        <Button
            android:id="@+id/btnAddDestination"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/add_destination"
            app:icon="@drawable/ic_add" />

        <!-- Metadata -->
        <TextView
            style="@style/SettingsSectionHeader"
            android:text="@string/section_metadata" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/live_title_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/live_description_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Quality -->
        <TextView
            style="@style/SettingsSectionHeader"
            android:text="@string/section_quality" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/resolution_label">

            <AutoCompleteTextView
                android:id="@+id/resolutionDropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/resolutionSupportNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/rate_control_note"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/fps_label">

            <AutoCompleteTextView
                android:id="@+id/fpsDropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/bitrate_label">

            <AutoCompleteTextView
                android:id="@+id/bitrateDropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Audio -->
        <TextView
            style="@style/SettingsSectionHeader"
            android:text="@string/section_audio" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/video_audio"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderVideoVolume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="5"
            android:valueFrom="0"
            android:valueTo="100" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/microphone"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderMicVolume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="5"
            android:valueFrom="0"
            android:valueTo="100" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchMicDefault"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/microphone"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchEcho"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/echo_cancellation"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchNoise"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/noise_suppression"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <!-- Output format / Live Canvas (Part 2) -->
        <TextView
            style="@style/SettingsSectionHeader"
            android:text="@string/output_format" />

        <TextView
            android:id="@+id/canvasFormatSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/format_note_16_9"
            android:textColor="@color/secondary_cyan"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnOpenCanvas"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_gradient_button"
            android:text="@string/open_canvas_editor"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <!-- Overlays -->
        <TextView
            style="@style/SettingsSectionHeader"
            android:text="@string/section_overlays" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/overlaysList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            tools:itemCount="2" />

        <Button
            android:id="@+id/btnAddOverlay"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/add_overlay"
            app:icon="@drawable/ic_layers" />

        <TextView
            android:id="@+id/overlaysEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_overlays"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Scenes -->
        <TextView
            style="@style/SettingsSectionHeader"
            android:text="@string/section_scenes" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/scenesList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            tools:itemCount="2" />

        <Button
            android:id="@+id/btnAddScene"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/add_scene"
            app:icon="@drawable/ic_playlist" />

        <TextView
            android:id="@+id/scenesEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_scenes"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Save -->
        <Button
            android:id="@+id/btnSaveProject"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_gradient_button"
            android:text="@string/save_project"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />
    </LinearLayout>
</ScrollView>
