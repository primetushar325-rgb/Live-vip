<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.SettingsActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/settings_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ============ VIDEO ============ -->
            <TextView
                style="@style/SettingsSectionHeader"
                android:text="@string/section_video" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/setting_resolution">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/settingResolution"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/setting_fps">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/settingFps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/setting_bitrate">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/settingBitrate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/setting_keyframe">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/settingKeyframe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ============ AUDIO ============ -->
            <TextView
                style="@style/SettingsSectionHeader"
                android:text="@string/section_audio" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/setting_audio_bitrate">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/settingAudioBitrate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/setting_sample_rate">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/settingSampleRate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchStereo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/setting_stereo" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchEchoCanceler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setting_echo" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchNoiseSuppressor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setting_noise" />

            <!-- ============ STREAM ============ -->
            <TextView
                style="@style/SettingsSectionHeader"
                android:text="@string/section_stream" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchAutoReconnect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/setting_auto_reconnect" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/setting_reconnect_attempts">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/settingReconnectAttempts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ============ APPEARANCE ============ -->
            <TextView
                style="@style/SettingsSectionHeader"
                android:text="@string/section_appearance" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/setting_theme">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/settingTheme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ============ ADVANCED ============ -->
            <TextView
                style="@style/SettingsSectionHeader"
                android:text="@string/section_advanced" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchDebugLogging"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/setting_debug_logging" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchShowStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setting_show_stats" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"
                android:text="@string/setting_hw_note"
                android:textSize="12sp"
                android:alpha="0.7" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
