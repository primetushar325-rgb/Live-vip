<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/inputLayerTextLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/new_text_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputLayerText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/animation_label">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/layerAnimation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/layer_scale"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderLayerScale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="3"
            android:valueTo="100"
            app:labelBehavior="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/layer_opacity"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderLayerOpacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="100"
            app:labelBehavior="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/layer_rotation"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderLayerRotation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="-180"
            android:valueTo="180"
            app:labelBehavior="gone" />
    </LinearLayout>
</ScrollView>
