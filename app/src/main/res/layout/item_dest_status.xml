<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_dest_row"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <View
        android:id="@+id/destDot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/circle_dot"
        android:backgroundTint="@color/status_live" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/destName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="YouTube A" />

        <TextView
            android:id="@+id/destDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            tools:text="LIVE • 5.8 Mbps" />
    </LinearLayout>

    <TextView
        android:id="@+id/destState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/success_green"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="LIVE" />
</LinearLayout>
