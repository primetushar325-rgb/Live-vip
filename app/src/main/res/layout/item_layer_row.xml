<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_dest_row"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <ImageView
        android:id="@+id/layerIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_layers"
        app:tint="@color/secondary_cyan" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/layerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Subscribe Animation" />

        <TextView
            android:id="@+id/layerMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            tools:text="X 50% Y 85% • 40% • 15°" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnLayerUp"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Move up"
        android:src="@drawable/ic_drag_handle"
        app:tint="@color/text_secondary" />

    <ImageButton
        android:id="@+id/btnLayerVisible"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/visibility"
        android:src="@drawable/ic_check"
        app:tint="@color/success_green" />

    <ImageButton
        android:id="@+id/btnLayerLock"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/lock"
        android:src="@drawable/ic_close"
        app:tint="@color/text_secondary" />

    <ImageButton
        android:id="@+id/btnLayerDuplicate"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/duplicate"
        android:src="@drawable/ic_add"
        app:tint="@color/primary_purple" />

    <ImageButton
        android:id="@+id/btnLayerDelete"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/delete"
        android:src="@drawable/ic_delete"
        app:tint="@color/error_soft_red" />
</LinearLayout>
