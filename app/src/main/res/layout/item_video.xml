<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/outline_subtle"
    app:cardBackgroundColor="@color/card_graphite">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="170dp">

            <ImageView
                android:id="@+id/videoThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/preview_bg"
                android:scaleType="centerCrop"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/selectedBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="10dp"
                android:background="@drawable/bg_glass_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="@string/selected_for_live"
                android:textColor="@color/secondary_cyan"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/videoName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:maxLines="1"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    tools:text="My Live Video.mp4" />

                <TextView
                    android:id="@+id/videoMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    tools:text="720p • 30 FPS • 12:35 • Audio ✓" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUse"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingHorizontal="14dp"
                android:text="@string/use"
                android:textSize="12sp"
                app:icon="@drawable/ic_play" />

            <ImageButton
                android:id="@+id/btnMore"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/more"
                android:src="@drawable/ic_more_vert" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
